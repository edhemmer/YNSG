{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox"
      }
    },
    "device": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      }
    }
  }
}
