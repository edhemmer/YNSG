{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ynsg.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile",
  "ignoreCommand": "node scripts/ignored-build-step.mjs",
  "redirects": [
    {
      "source": "/franchise",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fix-it-guides",
      "destination": "/home-help/",
      "permanent": true
    },
    {
      "source": "/fix-it-guides/:path*",
      "destination": "/home-help/",
      "permanent": true
    },
    {
      "source": "/review",
      "destination": "https://g.page/r/CWxW2KabD1UWECE/review",
      "permanent": false
    },
    {
      "source": "/review/",
      "destination": "https://g.page/r/CWxW2KabD1UWECE/review",
      "permanent": false
    }
  ]
}
